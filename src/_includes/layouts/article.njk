---
layout: layouts/base.njk
---
<article class="section wrap">
  <p class="entry-meta">
    <time datetime="{{ date | dateISO }}">{{ date | dateReadable }}</time>
    {% if tags %}{% for tag in tags %}{% if tag != "articles" %}<span class="tag">{{ tag }}</span>{% endif %}{% endfor %}{% endif %}
  </p>
  <h1>{{ title }}</h1>
  {% set toc = content | withToc %}
  {% if toc.items.length > 1 %}{% include "partials/toc.njk" %}{% endif %}
  <div class="prose">
    {{ toc.html | safe }}
  </div>
</article>
