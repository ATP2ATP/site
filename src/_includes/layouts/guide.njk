---
layout: layouts/base.njk
---
<article class="section wrap">
  <p class="entry-meta">
    <time datetime="{{ date | dateISO }}">Last updated {{ date | dateReadable }}</time>
    {% if tags %}{% for tag in tags %}{% if tag != "knowledgebase" %}<a class="tag" href="/knowledgebase/tags/{{ tag | slugify }}/">{{ tag }}</a>{% endif %}{% endfor %}{% endif %}
  </p>
  <h1>{{ title }}</h1>
  {% if summary %}<p class="lede lede-inline">{{ summary }}</p>{% endif %}

  {% if materials %}
  <div class="callout">
    <strong>You'll need:</strong>
    <ul>
      {% for item in materials %}<li>{{ item }}</li>{% endfor %}
    </ul>
  </div>
  {% endif %}

  {% set toc = content | withToc %}
  {% if toc.items.length > 1 %}{% include "partials/toc.njk" %}{% endif %}

  <div class="prose">
    {{ toc.html | safe }}
  </div>
</article>
