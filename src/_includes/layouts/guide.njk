---
layout: layouts/base.njk
---
<article class="section wrap">
  <p class="entry-meta">
    <time datetime="{{ date | dateISO }}">Last updated {{ date | dateReadable }}</time>
    {% if tags %}{% for tag in tags %}{% if tag != "knowledgebase" %}<span class="tag">{{ tag }}</span>{% endif %}{% endfor %}{% endif %}
  </p>
  <h1>{{ title }}</h1>
  {% if summary %}<p class="lede lede-inline">{{ summary }}</p>{% endif %}

  {% if materials %}
  <div class="callout">
    <strong>You'll need:</strong>
    <ul>
      {% for item in materials %}<li>{{ item }}</li>{% endfor %}
    </ul>
  </div>
  {% endif %}

  <div class="prose">
    {{ content | safe }}
  </div>
</article>
